#!/usr/bin/env python3
"""fwx: the framework's command line. `fwx <object> [<verb>] [args]` runs the handler lib/fwx/routes.py names for it.

A command is a name of the grammar (tool, object, verb: `fwx phase new`); lib/fwx/routes.py is the one table that says which file
of lib/fwx/commands/ runs it, what its help line is, and what each old name is now called. An old name is refused with one line
that names the new one. An object alone runs its default verb where the table gives it one (`fwx wave`, `fwx linear`).

Dispatch imports only the module asked for, never its neighbours: `fwx statusline` has to finish in under 100 ms, and a
neighbour that fails to import must not break the command that was asked. The listing reads the table and imports nothing.
"""
import importlib
import os
import re
import sys

LIB = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib")
sys.path.insert(0, LIB)
NAME = re.compile(r"[a-z][a-z0-9]*(-[a-z0-9]+)*\Z")


def usage(out, only=None):
    from fwx import routes
    if only:
        out.write("usage: fwx %s <verb> [args]\n\n" % only)
        groups = {only: routes.objects()[only]}
    else:
        out.write("usage: fwx <object> [<verb>] [args]   (fwx <object> --help lists the verbs of an object)\n\n")
        groups = routes.objects()
    names = [r[0] for rows in groups.values() for r in rows]
    width = max(map(len, names), default=0) + 4  # "fwx " is not in the name
    single = True  # one-row objects (budget, model, ...) share a block; an object with verbs has its own
    for obj, rows in groups.items():
        if only is None and (len(rows) > 1 or not single):
            out.write("\n")
        single = len(rows) == 1
        for r in rows:
            out.write("  fwx %s  %s\n" % (r[0].ljust(width - 4), r[4]))


def main(argv):
    if not argv or argv[0] in ("help", "-h", "--help"):
        usage(sys.stdout)
        return 0
    from fwx import routes
    old = routes.refusal(argv)
    if old:
        sys.stderr.write(old + "\n")
        return 2
    got = routes.route(argv) if NAME.match(argv[0]) else None
    if got is None:
        sys.stderr.write("fwx: unknown command: %s\n\n" % argv[0])
        usage(sys.stderr)
        return 2
    if got[0] == "help":
        usage(sys.stdout, got[1])
        return 0
    if got[0] == "verb?":
        sys.stderr.write("fwx %s: %s\n\n" % (got[1], "unknown verb: %s" % argv[1] if len(argv) > 1 else "needs a verb"))
        usage(sys.stderr, got[1])
        return 2
    module = importlib.import_module("fwx.commands." + got[0])
    return module.main(got[1]) or 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
