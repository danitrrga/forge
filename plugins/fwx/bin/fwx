#!/usr/bin/env python3
"""fwx: the framework's command line. `fwx <cmd> [args]` runs lib/fwx/commands/<cmd>.py.

A command is a file: its name is the subcommand (an underscore in the file name is a dash on
the command line), its `main(argv: list[str]) -> int` runs it, and the first line of its module
docstring is its help. There is no registry to edit.

A command can also be written verb first, `fwx <verb> <noun> [args]`: a file commands/<verb>_<noun>.py runs
as that, or a row of lib/fwx/names.py maps the two words to a command and subcommand of today
(`fwx find phase` is `fwx state resolve`). A name that is a command of its own is never looked up there.

Dispatch imports only the module asked for, never its neighbours: `fwx statusline` has to finish
in under 100 ms, and a neighbour that fails to import must not break the command that was asked.
The listing reads each docstring with `ast` and imports nothing, so a broken module does not break it.
"""
import ast
import importlib
import os
import re
import sys

LIB = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib")
COMMANDS = os.path.join(LIB, "fwx", "commands")
NAME = re.compile(r"[a-z][a-z0-9]*(-[a-z0-9]+)*\Z")


def modules():
    """{subcommand: path} for every commands/<name>.py; a file starting with `_` is not a command."""
    found = {}
    for f in sorted(os.listdir(COMMANDS)):
        if f.endswith(".py") and not f.startswith("_"):
            found[f[:-3].replace("_", "-")] = os.path.join(COMMANDS, f)
    return found


def first_line(path):
    try:
        with open(path, encoding="utf-8") as fh:
            doc = ast.get_docstring(ast.parse(fh.read(), path))
    except (OSError, SyntaxError, ValueError):
        return "(unreadable)"
    return doc.strip().splitlines()[0] if doc and doc.strip() else ""


def verb_lines():
    """The listing's verb-first block, read from the names table: one line per verb, `  verb: noun, noun`. A line is
    not two columns, so a reader of the command rows above (a name, two spaces, its help) does not take a verb for a command.
    An unreadable table gives a line saying so, never a failure of the listing."""
    try:
        sys.path.insert(0, LIB)
        from fwx import names
        verbs = names.verbs()
    except Exception as e:  # noqa: BLE001: the listing must survive a broken neighbour
        return ["  (the names table cannot be read: %s)\n" % e.__class__.__name__]
    return ["  %s: %s\n" % (verb, ", ".join(nouns)) for verb, nouns in verbs.items()]


def usage(out):
    cmds = modules()
    out.write("usage: fwx <command> [args]\n       fwx <verb> <noun> [args]\n\ncommands:\n")
    width = max(map(len, cmds), default=0)
    for name, path in cmds.items():
        out.write("  %s  %s\n" % (name.ljust(width), first_line(path)))
    out.write("\nverb first (the same commands; lib/fwx/names.py says which each one reaches):\n")
    out.writelines(verb_lines())


def run(cmd, argv):
    sys.path.insert(0, LIB)
    module = importlib.import_module("fwx.commands." + cmd.replace("-", "_"))
    return module.main(argv) or 0


def two_words(cmds, argv):
    """(command, its argv) for `<verb> <noun> ...`: a file commands/<verb>_<noun>.py, else a row of the names table; None
    when neither has it. Only here is the table imported, so a command of its own never pays for it."""
    word = argv[0] + "-" + argv[1]
    if word in cmds:
        return word, argv[2:]
    try:
        sys.path.insert(0, LIB)
        from fwx import names
    except Exception as e:  # noqa: BLE001: a broken table is a message, not a traceback
        sys.stderr.write("fwx: the names table cannot be read: %s: %s\n" % (e.__class__.__name__, e))
        return None
    old = names.lookup(argv[0] + " " + argv[1])
    return (old[0], old[1:] + argv[2:]) if old else None


def main(argv):
    if not argv or argv[0] in ("help", "-h", "--help"):
        usage(sys.stdout)
        return 0
    cmd, cmds = argv[0], modules()
    if NAME.match(cmd) and cmd in cmds:
        return run(cmd, argv[1:])
    tried = argv[:1]
    if NAME.match(cmd) and len(argv) > 1 and NAME.match(argv[1]):
        tried = argv[:2]
        found = two_words(cmds, argv)
        if found:
            return run(*found)
    sys.stderr.write("fwx: unknown command: %s\n\n" % " ".join(tried))
    usage(sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
