#!/usr/bin/env python3
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
try:
    from forge.cli import main
except Exception as e:  # forge itself is broken (mid-rebase, a syntax error): a session must still start
    if sys.argv[1:2] == ["session-start"]:
        print(json.dumps({"systemMessage": "forge session-start could not load forge (%s: %s); "
                          "this project's config was not synced" % (type(e).__name__, e)}))
        sys.exit(0)
    raise

sys.exit(main())
