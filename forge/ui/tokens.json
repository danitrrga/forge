{
  "schema": 1,
  "about": "The one source of forge's look. Roles and glyphs are named here and nowhere else; the terminal renderer, the HTML gallery and the CSS custom properties are all generated from this file. Edit a value here, never in a renderer.",
  "themes": {
    "dark": {
      "ground": "#0c080a",
      "ink": "#f2edef",
      "body": "#d9d2d6",
      "mute": "#a59b9f",
      "dim": "#8d888a",
      "faint": "#5c5457",
      "line": "#322c2e",
      "band": "#241d20",
      "accent": "#f272b0",
      "ramp": ["#a14c78", "#b5588a", "#cd5f98", "#f272b0"],
      "warn": "#f0c866",
      "ok": "#8fd6a8",
      "error": "#ff7b5c",
      "warn_band": "#2a2310",
      "error_band": "#2e1612",
      "ok_band": "#13261a",
      "neutral_band": "#241e21"
    },
    "light": {
      "ground": "#f6f2f4",
      "ink": "#171214",
      "body": "#2a2326",
      "mute": "#4a4246",
      "dim": "#6d6468",
      "faint": "#a59b9f",
      "line": "#ddd9db",
      "band": "#e9e5e7",
      "accent": "#b0346f",
      "ramp": ["#c0578c", "#b94a82", "#b43f79", "#b0346f"],
      "warn": "#7a5200",
      "ok": "#1d6a38",
      "error": "#a1252b",
      "warn_band": "#f3e6bf",
      "error_band": "#f5d9d4",
      "ok_band": "#d6ecdc",
      "neutral_band": "#e9e5e7"
    }
  },
  "roles": {
    "ink": {"kind": "text", "use": "names and anything that must be read first; in a terminal this is the terminal's own foreground, bold"},
    "body": {"kind": "text", "use": "ordinary values; in a terminal the terminal's own foreground"},
    "mute": {"kind": "text", "use": "secondary text: tree items, units, actions on a band"},
    "dim": {"kind": "text", "use": "hints, the key line, labels in a table header; the dimmest colour that is still text"},
    "faint": {"kind": "decoration", "use": "rails, tree lines, empty meter cells, a disabled row; never text that has to be read"},
    "line": {"kind": "decoration", "use": "hairlines on the web and in the gallery; not used in a terminal"},
    "band": {"kind": "surface", "use": "the background of the cursor row"},
    "accent": {"kind": "text", "use": "the one brand colour: step markers, the selected mark, the filled part of a meter, the profile mark"},
    "ramp": {"kind": "graphic", "use": "four tints of the accent, dim to full, for a meter that fills from left to right"},
    "warn": {"kind": "text", "use": "one meaning only: you asked for something that cannot be done (refused) or a count that needs a look"},
    "error": {"kind": "text", "use": "one meaning only: it is broken and cannot proceed"},
    "ok": {"kind": "text", "use": "one meaning only: done or passed"}
  },
  "contrast": {
    "text_min": 4.5,
    "graphic_min": 3.0,
    "text": ["ink", "body", "mute", "dim", "accent", "warn", "ok", "error"],
    "graphic": ["ramp"],
    "surfaces": ["ground", "band"],
    "on_coloured_bands": {"roles": ["ink", "mute"], "bands": ["warn_band", "error_band", "ok_band", "neutral_band"], "own_role": {"warn_band": "warn", "error_band": "error", "ok_band": "ok"}}
  },
  "glyphs": {
    "nerd": {
      "rail_v": "│", "rail_start": "┌", "rail_end": "└",
      "step_active": "◆",
      "tree_mid": "├", "tree_last": "└", "tree_pipe": "│",
      "check_on": "◼", "check_off": "◻", "nest": "▸",
      "meter_full": "▰", "meter_empty": "▱",
      "mark": "⬢",
      "dot_build": "◆", "dot_plan": "◇", "dot_check": "●", "dot_read": "○",
      "icon_refused": "▲", "icon_broken": "\uf00d", "icon_frozen": "\uf2dc", "icon_stale": "\udb81\udeb0", "icon_done": "✓",
      "sep": "·", "more": "↓", "enter": "⏎", "updown": "↑↓", "arrow": "→", "ellipsis": "…"
    },
    "unicode": {
      "rail_v": "│", "rail_start": "┌", "rail_end": "└",
      "step_active": "◆",
      "tree_mid": "├", "tree_last": "└", "tree_pipe": "│",
      "check_on": "◼", "check_off": "◻", "nest": "▸",
      "meter_full": "▰", "meter_empty": "▱",
      "mark": "⬢",
      "dot_build": "◆", "dot_plan": "◇", "dot_check": "●", "dot_read": "○",
      "icon_refused": "▲", "icon_broken": "×", "icon_frozen": "*", "icon_stale": "↑", "icon_done": "✓",
      "sep": "·", "more": "↓", "enter": "⏎", "updown": "↑↓", "arrow": "→", "ellipsis": "…"
    },
    "ascii": {
      "rail_v": "|", "rail_start": "+", "rail_end": "+",
      "step_active": "*",
      "tree_mid": "+", "tree_last": "`", "tree_pipe": "|",
      "check_on": "x", "check_off": ".", "nest": ">",
      "meter_full": "#", "meter_empty": "-",
      "mark": "*",
      "dot_build": "#", "dot_plan": "+", "dot_check": "*", "dot_read": "o",
      "icon_refused": "!", "icon_broken": "x", "icon_frozen": "*", "icon_stale": "~", "icon_done": "+",
      "sep": "-", "more": "v", "enter": "enter", "updown": "up/down", "arrow": "->", "ellipsis": "~"
    },
    "cell_glyphs": [
      "rail_v", "rail_start", "rail_end", "step_active", "tree_mid", "tree_last", "tree_pipe",
      "check_on", "check_off", "nest", "meter_full", "meter_empty", "mark",
      "dot_build", "dot_plan", "dot_check", "dot_read",
      "icon_refused", "icon_broken", "icon_frozen", "icon_stale", "icon_done", "sep", "ellipsis"
    ]
  },
  "layout": {
    "widths": {"narrow": 60, "default": 80, "wide": 120},
    "measure": 66,
    "meter_cells": 10,
    "keys_gap_lines": 1,
    "alert_gap_lines": 1
  }
}
