+def render_csv(rows):
+    out = io.StringIO()
+    writer = csv.writer(out, lineterminator="\n")
+    writer.writerow(["customer", "orders", "total"])
+    for customer, n, cents in rows:
+        writer.writerow([customer, n, "%.2f" % (cents / 100)])
+    return out.getvalue()
+
+
