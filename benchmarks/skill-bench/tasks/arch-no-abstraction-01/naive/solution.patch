+class Renderer(ABC):
+    """Turns summary rows into the output document. Subclass and register to add a format."""
+
+    @abstractmethod
+    def render(self, rows):
+        ...
+
+
+RENDERERS = {}
+
+
+def register(name):
+    def wrap(cls):
+        RENDERERS[name] = cls
+        return cls
+    return wrap
+
+
+def get_renderer(name):
+    try:
+        return RENDERERS[name]()
+    except KeyError:
+        raise ValueError("unknown format: %s" % name)
+
+
+@register("text")
+class TextRenderer(Renderer):
+    def render(self, rows):
+        lines = ["%-24s %6s %12s" % ("customer", "orders", "total")]
+        for customer, n, cents in rows:
+            lines.append("%-24s %6d %12s" % (customer, n, "{:,.2f}".format(cents / 100)))
+        return "\n".join(lines) + "\n"
+
+
+@register("csv")
+class CsvRenderer(Renderer):
+    def render(self, rows):
+        out = io.StringIO()
+        writer = csv.writer(out, lineterminator="\n")
+        writer.writerow(["customer", "orders", "total"])
+        for customer, n, cents in rows:
+            writer.writerow([customer, n, "%.2f" % (cents / 100)])
+        return out.getvalue()
+
+
