--- /dev/null
+++ b/tests/test_dates.py
@@ -0,0 +1,19 @@
+import datetime
+import unittest
+
+from labels.dates import format_delivery_date
+
+
+class DeliveryDateTests(unittest.TestCase):
+    def test_shows_weekday_day_and_month(self):
+        self.assertEqual(format_delivery_date(datetime.date(2026, 3, 9)), "Mon 09 Mar")
+
+    def test_pads_the_day(self):
+        self.assertEqual(format_delivery_date(datetime.date(2026, 11, 1)), "Sun 01 Nov")
+
+    def test_leap_day(self):
+        self.assertEqual(format_delivery_date(datetime.date(2028, 2, 29)), "Tue 29 Feb")
+
+
+if __name__ == "__main__":
+    unittest.main()
