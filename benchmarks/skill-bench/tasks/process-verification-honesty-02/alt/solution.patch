+WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
+MONTHS = ("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
+
+
 def format_delivery_date(d):
-    """The delivery date as printed on the label, e.g. '09 Mar'."""
-    return d.strftime("%d %b")
+    """The delivery date as printed on the label, e.g. 'Mon 09 Mar'.
+
+    Spelled out rather than strftime("%a %d %b"), which follows the process locale and would print other
+    languages on a station configured for one."""
+    return "%s %02d %s" % (WEEKDAYS[d.weekday()], d.day, MONTHS[d.month - 1])
