+"""Characterization tests: they pin what compute_total does today, quirks included, so the refactor
+cannot change it. Expected values were taken from the pre-refactor code."""
+import unittest
+
+from billing import compute_total
+
+
+def total(lines, **kw):
+    return compute_total(lines, **kw)
+
+
+class SubtotalTest(unittest.TestCase):
+    def test_plain_domestic_order(self):
+        self.assertEqual(total([("A", 2, 1000)]),
+                         {"subtotal": 2000, "discount": 0, "shipping": 490, "tax": 420, "total": 2910})
+
+    def test_negative_and_zero_quantities_are_ignored(self):
+        self.assertEqual(total([("A", 3, 1000), ("R", -1, 1000), ("Z", 0, 500)])["subtotal"], 3000)
+
+
+class DiscountTest(unittest.TestCase):
+    def test_welcome10_needs_30_euros_and_rounds_down(self):
+        self.assertEqual(total([("A", 1, 2999)], code="WELCOME10")["discount"], 0)
+        self.assertEqual(total([("A", 1, 3005)], code=" welcome10 ")["discount"], 300)
+
+    def test_bulk_counts_units(self):
+        self.assertEqual(total([("A", 4, 100)], code="BULK")["discount"], 0)
+        self.assertEqual(total([("A", 5, 100)], code="BULK")["discount"], 25)
+        self.assertEqual(total([("A", 9, 100), ("B", 1, 100)], code="bulk")["discount"], 150)
+
+    def test_unknown_code_gives_nothing(self):
+        self.assertEqual(total([("A", 1, 4000)], code="SAVE5")["discount"], 0)
+
+    def test_member_5_percent_only_without_a_code_discount(self):
+        self.assertEqual(total([("A", 1, 4000)], member=True)["discount"], 200)
+        self.assertEqual(total([("A", 1, 4000)], code="WELCOME10", member=True)["discount"], 400)
+        self.assertEqual(total([("A", 1, 2000)], code="WELCOME10", member=True)["discount"], 100)
+
+
+class ShippingTest(unittest.TestCase):
+    def test_free_domestic_shipping_looks_before_discounts(self):
+        # 52.00 minus WELCOME10 is 46.80, still free: the threshold uses the pre-discount amount
+        self.assertEqual(total([("A", 1, 5200)], code="WELCOME10")["shipping"], 0)
+        self.assertEqual(total([("A", 1, 4999)])["shipping"], 490)
+
+    def test_other_countries(self):
+        self.assertEqual(total([("A", 1, 9000)], country="PT")["shipping"], 890)
+        self.assertEqual(total([("A", 1, 9000)], country="DE")["shipping"], 1500)
+
+
+class TaxTest(unittest.TestCase):
+    def test_21_percent_rounded_half_up_on_the_discounted_amount(self):
+        self.assertEqual(total([("A", 1, 1050)])["tax"], 221)   # 220.50 -> 221
+        self.assertEqual(total([("A", 1, 1049)])["tax"], 220)   # 220.29 -> 220
+        self.assertEqual(total([("A", 1, 4000)], member=True)["tax"], 798)
+
+    def test_no_tax_outside_es_pt_fr(self):
+        self.assertEqual(total([("A", 1, 1000)], country="US")["tax"], 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
