+"""compute_total as it behaved before the 2026 refactor, recorded from the old code. Do not edit an expected
+value to make a change pass: a difference here is a change in what customers pay."""
+import unittest
+
+from billing import compute_total
+
+RECORDED = [
+    ('plain domestic', [('A', 2, 1000)], {},
+     {'subtotal': 2000, 'discount': 0, 'shipping': 490, 'tax': 420, 'total': 2910}),
+    ('return line ignored', [('A', 3, 1000), ('R', -1, 1000)], {},
+     {'subtotal': 3000, 'discount': 0, 'shipping': 490, 'tax': 630, 'total': 4120}),
+    ('zero line ignored', [('A', 1, 1000), ('Z', 0, 700)], {},
+     {'subtotal': 1000, 'discount': 0, 'shipping': 490, 'tax': 210, 'total': 1700}),
+    ('welcome10 below 30', [('A', 1, 2999)], {'code': 'WELCOME10'},
+     {'subtotal': 2999, 'discount': 0, 'shipping': 490, 'tax': 630, 'total': 4119}),
+    ('welcome10 rounds down', [('A', 1, 3005)], {'code': ' welcome10 '},
+     {'subtotal': 3005, 'discount': 300, 'shipping': 490, 'tax': 568, 'total': 3763}),
+    ('bulk 4 units', [('A', 4, 100)], {'code': 'BULK'},
+     {'subtotal': 400, 'discount': 0, 'shipping': 490, 'tax': 84, 'total': 974}),
+    ('bulk 5 units', [('A', 5, 100)], {'code': 'BULK'},
+     {'subtotal': 500, 'discount': 25, 'shipping': 490, 'tax': 100, 'total': 1065}),
+    ('bulk 10 units over two lines', [('A', 9, 100), ('B', 1, 100)], {'code': 'bulk'},
+     {'subtotal': 1000, 'discount': 150, 'shipping': 490, 'tax': 179, 'total': 1519}),
+    ('member alone', [('A', 1, 4000)], {'member': True},
+     {'subtotal': 4000, 'discount': 200, 'shipping': 490, 'tax': 798, 'total': 5088}),
+    ('member with a code that applies', [('A', 1, 4000)], {'code': 'WELCOME10', 'member': True},
+     {'subtotal': 4000, 'discount': 400, 'shipping': 490, 'tax': 756, 'total': 4846}),
+    ('member with a code that does not', [('A', 1, 2000)], {'code': 'WELCOME10', 'member': True},
+     {'subtotal': 2000, 'discount': 100, 'shipping': 490, 'tax': 399, 'total': 2789}),
+    ('free shipping before discount', [('A', 1, 5200)], {'code': 'WELCOME10'},
+     {'subtotal': 5200, 'discount': 520, 'shipping': 0, 'tax': 983, 'total': 5663}),
+    ('just under free shipping', [('A', 1, 4999)], {},
+     {'subtotal': 4999, 'discount': 0, 'shipping': 490, 'tax': 1050, 'total': 6539}),
+    ('portugal', [('A', 1, 9000)], {'country': 'PT'},
+     {'subtotal': 9000, 'discount': 0, 'shipping': 890, 'tax': 1890, 'total': 11780}),
+    ('germany', [('A', 1, 1000)], {'country': 'DE'},
+     {'subtotal': 1000, 'discount': 0, 'shipping': 1500, 'tax': 0, 'total': 2500}),
+    ('tax half up', [('A', 1, 1050)], {'country': 'FR'},
+     {'subtotal': 1050, 'discount': 0, 'shipping': 890, 'tax': 221, 'total': 2161}),
+    ('tax below half', [('A', 1, 1049)], {},
+     {'subtotal': 1049, 'discount': 0, 'shipping': 490, 'tax': 220, 'total': 1759}),
+    ('empty cart', [], {},
+     {'subtotal': 0, 'discount': 0, 'shipping': 490, 'tax': 0, 'total': 490}),
+]
+
+
+class RecordedTotalsTest(unittest.TestCase):
+    def test_recorded_totals(self):
+        for name, lines, kwargs, expected in RECORDED:
+            with self.subTest(name):
+                self.assertEqual(compute_total(lines, **kwargs), expected)
+
+
+if __name__ == "__main__":
+    unittest.main()
