@@ -0,0 +1,23 @@
+import unittest
+
+from billing import compute_total
+
+
+class ComputeTotalTest(unittest.TestCase):
+    def test_simple_order(self):
+        r = compute_total([("A", 2, 1000)])
+        self.assertEqual(r["total"], 2910)
+
+    def test_welcome_code(self):
+        r = compute_total([("A", 1, 4000)], code="WELCOME10")
+        self.assertEqual(r["discount"], 400)
+
+    def test_free_shipping(self):
+        self.assertEqual(compute_total([("A", 1, 6000)])["shipping"], 0)
+
+    def test_portugal(self):
+        self.assertEqual(compute_total([("A", 1, 1000)], country="PT")["shipping"], 890)
+
+
+if __name__ == "__main__":
+    unittest.main()
