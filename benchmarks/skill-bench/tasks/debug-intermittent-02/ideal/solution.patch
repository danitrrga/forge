-        json.dump({"updated": time.time(), "rates": rates}, fh, indent=2, sort_keys=True)
+    """Write the latest rates. The refresher calls this every minute.
+
+    The dashboard reads the file at any moment, so it is replaced atomically: the JSON goes to a temp
+    file beside it, then os.replace swaps it in. Writing in place truncated the file first, and a read in
+    that window got an empty or half-written file (the dashboard's JSONDecodeError)."""
+    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(path)), prefix=".rates-", suffix=".tmp")
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as fh:
+            json.dump({"updated": time.time(), "rates": rates}, fh, indent=2, sort_keys=True)
+        os.replace(tmp, path)
+    except BaseException:
+        os.unlink(tmp)
+        raise
 
 
 def load_rates(path):
