diff --git a/crm/store.py b/crm/store.py
index ad856fa..1f27171 100644
--- a/crm/store.py
+++ b/crm/store.py
@@ -35,3 +35,22 @@ def add_customer(customers, name, email, phone=""):
     customer = {"name": " ".join(name.split()), "email": email, "phone": phone.strip()}
     customers.append(customer)
     return customer
+
+
+def import_csv(customers, path):
+    """Add every customer from an export of the old CRM; returns (added, skipped) lists of emails.
+
+    The export is what Excel writes: UTF-8 with a byte-order mark, ';' between fields, columns
+    Name;E-mail;Phone;Customer since. Customers already in the list are skipped, not overwritten."""
+    import csv
+
+    added, skipped = [], []
+    with open(path, encoding="utf-8-sig", newline="") as fh:
+        for row in csv.DictReader(fh, delimiter=";"):
+            email = row["E-mail"].strip().lower()
+            if find(customers, email):
+                skipped.append(email)
+                continue
+            add_customer(customers, row["Name"], email, row.get("Phone") or "")
+            added.append(email)
+    return added, skipped
