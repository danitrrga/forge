diff --git a/tests/test_import.py b/tests/test_import.py
new file mode 100644
index 0000000..7ae89fe
--- /dev/null
+++ b/tests/test_import.py
@@ -0,0 +1,24 @@
+import os
+import tempfile
+import unittest
+
+from crm import store
+
+EXPORT = "Name;E-mail;Phone;Customer since\r\nBen Okafor;BEN@example.test;+44 1;2019-04-02\r\nJoão Silva;joao@example.test;;2022-07-18\r\n"
+
+
+class ImportTests(unittest.TestCase):
+    def test_reads_the_old_crm_export(self):
+        with tempfile.TemporaryDirectory() as d:
+            path = os.path.join(d, "export.csv")
+            with open(path, "wb") as fh:
+                fh.write(b"\xef\xbb\xbf" + EXPORT.encode("utf-8"))  # Excel writes a byte-order mark
+            customers = [{"name": "Ben Okafor", "email": "ben@example.test", "phone": ""}]
+            added, skipped = store.import_csv(customers, path)
+        self.assertEqual(added, ["joao@example.test"])
+        self.assertEqual(skipped, ["ben@example.test"])
+        self.assertEqual(customers[1], {"name": "João Silva", "email": "joao@example.test", "phone": ""})
+
+
+if __name__ == "__main__":
+    unittest.main()
