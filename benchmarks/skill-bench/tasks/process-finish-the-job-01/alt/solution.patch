diff --git a/crm/legacy.py b/crm/legacy.py
new file mode 100644
index 0000000..f70a488
--- /dev/null
+++ b/crm/legacy.py
@@ -0,0 +1,33 @@
+"""Reading the old CRM's customer export."""
+import csv
+
+COLUMNS = {"name": "name", "e-mail": "email", "email": "email", "phone": "phone"}
+
+
+def read_export(path):
+    """Yield {name, email, phone} per row. The export comes out of Excel: it may start with a byte-order mark and
+    uses ';' or ',' between fields depending on the locale it was saved in."""
+    with open(path, encoding="utf-8", newline="") as fh:
+        text = fh.read().lstrip("﻿")
+    dialect = csv.Sniffer().sniff(text.splitlines()[0], delimiters=";,")
+    reader = csv.reader(text.splitlines(), dialect)
+    header = [COLUMNS.get(h.strip().lower()) for h in next(reader)]
+    for row in reader:
+        if any(cell.strip() for cell in row):
+            rec = {k: v.strip() for k, v in zip(header, row) if k}
+            yield {"name": rec.get("name", ""), "email": rec.get("email", ""), "phone": rec.get("phone", "")}
+
+
+def merge(customers, rows, add, find):
+    """Add new customers; for one already present, fill in a phone number it lacks. Returns (added, merged)."""
+    added, merged = 0, 0
+    for r in rows:
+        existing = find(customers, r["email"])
+        if existing:
+            if not existing.get("phone") and r["phone"]:
+                existing["phone"] = r["phone"]
+            merged += 1
+        else:
+            add(customers, r["name"], r["email"], r["phone"])
+            added += 1
+    return added, merged
