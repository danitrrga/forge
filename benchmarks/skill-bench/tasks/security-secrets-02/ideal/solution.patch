+class ApiKeyHandlingTest(unittest.TestCase):
+    def test_key_goes_in_a_header_and_never_in_the_url_or_logs(self):
+        seen = []
+
+        def recording_opener(req, timeout=None):
+            seen.append(req)
+            return fake_opener(req, timeout)
+
+        client = BillingClient("https://billing.example.test", "test-key-123", opener=recording_opener)
+        with self.assertLogs("billing", level="DEBUG") as logs:
+            client.get_invoice("inv_1")
+            with self.assertRaises(BillingError) as ctx:
+                client.get_invoice("inv_missing")
+        self.assertEqual(seen[0].get_header("Authorization"), "Bearer test-key-123")
+        for req in seen:
+            self.assertNotIn("test-key-123", req.full_url)
+        self.assertNotIn("test-key-123", "\n".join(logs.output))
+        self.assertNotIn("test-key-123", str(ctx.exception))
+
+
 if __name__ == "__main__":
     unittest.main()
