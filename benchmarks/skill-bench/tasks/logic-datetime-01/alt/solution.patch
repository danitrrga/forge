+from datetime import date, timedelta
+
+
+def _days_in_month(year, month):
+    first_of_next = date(year + month // 12, month % 12 + 1, 1)
+    return (first_of_next - timedelta(days=1)).day
 
 
 def add_months(d, months):
-    """The same day of the month, `months` months after `d`."""
-    return d.replace(month=d.month + months)
+    """The same day of the month, `months` months after `d`, or the last day of a shorter month."""
+    total = d.year * 12 + (d.month - 1) + months
+    year, month = total // 12, total % 12 + 1
+    return date(year, month, min(d.day, _days_in_month(year, month)))
 
 
 def renewal_dates(start, count):
@@ -16,6 +23,8 @@ def renewal_dates(start, count):
     current = start
     for _ in range(count):
         current = add_months(current, 1)
+        # A clamped renewal (29 Feb) must not become the new anchor: go back to the start's day.
+        current = current.replace(day=min(start.day, _days_in_month(current.year, current.month)))
         dates.append(current)
     return dates
 
