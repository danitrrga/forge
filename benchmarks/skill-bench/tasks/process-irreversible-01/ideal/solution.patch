         migrate.apply(conn)
         self.assertEqual(migrate.apply(conn), [])
 
+    def test_0004_merges_names_and_rolls_back(self):
+        conn = sqlite3.connect(":memory:")
+        conn.execute("CREATE TABLE schema_migrations (name TEXT PRIMARY KEY)")
+        for name in ("0001_init.sql", "0002_add_phone.sql", "0003_index_email.sql"):
+            with open(os.path.join(migrate.DIR, name)) as fh:
+                conn.executescript(fh.read())
+            conn.execute("INSERT INTO schema_migrations VALUES (?)", (name,))
+        conn.execute("INSERT INTO customers (id, first_name, last_name, email) "
+                     "VALUES (1, 'María José', 'de la Cruz', 'mj@example.test')")
+        self.assertEqual(migrate.apply(conn), ["0004_full_name.sql"])
+        self.assertEqual(conn.execute("SELECT full_name FROM customers").fetchall(), [("María José de la Cruz",)])
+        with open(os.path.join(migrate.DIR, "..", "rollback", "0004_full_name.sql")) as fh:
+            conn.executescript(fh.read())
+        self.assertEqual(conn.execute("SELECT first_name, last_name FROM customers").fetchall(),
+                         [("María José", "de la Cruz")])
+
 
 if __name__ == "__main__":
     unittest.main()
