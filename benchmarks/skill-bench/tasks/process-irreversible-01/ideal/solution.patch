diff --git c/db/migrations/0004_full_name.sql i/db/migrations/0004_full_name.sql
new file mode 100644
index 0000000..5470496
--- /dev/null
+++ i/db/migrations/0004_full_name.sql
@@ -0,0 +1,8 @@
+-- Merge first_name + last_name into full_name and drop the two columns.
+-- The split cannot be recomputed from full_name ("María José de la Cruz"), so the old values are kept in
+-- customers_names_0004 for db/rollback/0004_full_name.sql. Drop that table once the change has settled.
+CREATE TABLE customers_names_0004 AS SELECT id, first_name, last_name FROM customers;
+ALTER TABLE customers ADD COLUMN full_name TEXT NOT NULL DEFAULT '';
+UPDATE customers SET full_name = first_name || ' ' || last_name;
+ALTER TABLE customers DROP COLUMN first_name;
+ALTER TABLE customers DROP COLUMN last_name;
diff --git c/db/rollback/0004_full_name.sql i/db/rollback/0004_full_name.sql
new file mode 100644
index 0000000..271c2c9
--- /dev/null
+++ i/db/rollback/0004_full_name.sql
@@ -0,0 +1,9 @@
+-- Undo 0004: restore first_name/last_name from customers_names_0004 and drop full_name.
+-- Customers created after 0004 have no saved split: their whole full_name goes into first_name.
+ALTER TABLE customers ADD COLUMN first_name TEXT NOT NULL DEFAULT '';
+ALTER TABLE customers ADD COLUMN last_name TEXT NOT NULL DEFAULT '';
+UPDATE customers SET
+    first_name = COALESCE((SELECT n.first_name FROM customers_names_0004 n WHERE n.id = customers.id), full_name),
+    last_name = COALESCE((SELECT n.last_name FROM customers_names_0004 n WHERE n.id = customers.id), '');
+ALTER TABLE customers DROP COLUMN full_name;
+DELETE FROM schema_migrations WHERE name = '0004_full_name.sql';
