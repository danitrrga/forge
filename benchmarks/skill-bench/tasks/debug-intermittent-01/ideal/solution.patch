diff --git a/prefs/profiles.py b/prefs/profiles.py
index 05310db..b423173 100644
--- a/prefs/profiles.py
+++ b/prefs/profiles.py
@@ -1,4 +1,5 @@
 """User profiles and their preferences."""
+import copy
 import functools
 import json
 import os
@@ -15,7 +16,9 @@ def load_defaults():
 
 def new_profile(name, **overrides):
     """A profile with the default preferences, with any top-level preference overridden."""
-    prefs = load_defaults()
+    # A deep copy: load_defaults() returns the one cached dict, and callers mutate their profile's
+    # prefs (nested notifications included), which used to change every other profile's defaults.
+    prefs = copy.deepcopy(load_defaults())
     prefs.update(overrides)
     return {"name": name, "prefs": prefs}
 
