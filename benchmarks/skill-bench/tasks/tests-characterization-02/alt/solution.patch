@@ -0,0 +1,48 @@
+"""parse_date as it behaved before the rewrite (recorded from the old code). These are the booking form's
+contract, odd cases included; do not change an expected value to make a refactor pass."""
+import unittest
+from datetime import date
+
+from dates import parse_date
+
+RECORDED = [
+    ('2026-10-23', '2026-10-23'),
+    (' 2026-1-5 ', '2026-01-05'),
+    ('2026- 01-05', '2026-01-05'),
+    ('23/10/2026', '2026-10-23'),
+    ('23.10.2026', '2026-10-23'),
+    ('23/10/26', '2026-10-23'),
+    ('1/2/49', '2049-02-01'),
+    ('1/2/50', '1950-02-01'),
+    ('1/2/68', '1968-02-01'),
+    ('1/2/69', '1969-02-01'),
+    ('10/23/2026', '2026-10-23'),
+    ('10.23.26', '2026-10-23'),
+    ('13/13/2026', None),
+    ('12/13/2026', '2026-12-13'),
+    ('31/02/2026', None),
+    ('29/02/2028', '2028-02-29'),
+    ('2026-02-30', None),
+    ('23-10-2026', None),
+    ('26-10-23', None),
+    ('5/ 6/2026', '2026-06-05'),
+    ('5/6/ 2026', None),
+    ('5/6/202', None),
+    ('23/10', None),
+    ('23.10/2026', None),
+    ('abc', None),
+    ('', None),
+    (None, None),
+    ('0/1/2026', None),
+]
+
+
+class RecordedTest(unittest.TestCase):
+    def test_recorded(self):
+        for text, iso in RECORDED:
+            with self.subTest(text=text):
+                self.assertEqual(parse_date(text), date.fromisoformat(iso) if iso else None)
+
+
+if __name__ == "__main__":
+    unittest.main()
