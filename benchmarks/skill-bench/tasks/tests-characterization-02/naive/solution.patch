diff --git a/tests/test_dates.py b/tests/test_dates.py
new file mode 100644
index 0000000..84ee94d
--- /dev/null
+++ b/tests/test_dates.py
@@ -0,0 +1,28 @@
+import unittest
+from datetime import date
+
+from dates import parse_date
+
+
+class ParseDateTest(unittest.TestCase):
+    def test_iso(self):
+        self.assertEqual(parse_date("2026-10-23"), date(2026, 10, 23))
+
+    def test_european(self):
+        self.assertEqual(parse_date("23/10/2026"), date(2026, 10, 23))
+        self.assertEqual(parse_date("23.10.2026"), date(2026, 10, 23))
+
+    def test_short_year(self):
+        self.assertEqual(parse_date("23/10/26"), date(2026, 10, 23))
+
+    def test_american(self):
+        self.assertEqual(parse_date("10/23/2026"), date(2026, 10, 23))
+
+    def test_invalid(self):
+        self.assertIsNone(parse_date("31/02/2026"))
+        self.assertIsNone(parse_date("hello"))
+        self.assertIsNone(parse_date(""))
+
+
+if __name__ == "__main__":
+    unittest.main()
