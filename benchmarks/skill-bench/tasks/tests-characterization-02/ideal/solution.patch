+"""Characterization tests for parse_date: what it accepts and rejects today, recorded before the rewrite.
+Some of these are odd (the 50 pivot, dashes only in ISO order); they are pinned because the booking form
+relies on the current behaviour, not because they are ideal."""
+import unittest
+from datetime import date
+
+from dates import parse_date
+
+
+class AcceptedTest(unittest.TestCase):
+    def test_iso(self):
+        self.assertEqual(parse_date("2026-10-23"), date(2026, 10, 23))
+        self.assertEqual(parse_date(" 2026-1-5 "), date(2026, 1, 5))
+
+    def test_day_first_with_slash_or_dot(self):
+        self.assertEqual(parse_date("23/10/2026"), date(2026, 10, 23))
+        self.assertEqual(parse_date("23.10.26"), date(2026, 10, 23))
+
+    def test_two_digit_years_pivot_at_50(self):
+        self.assertEqual(parse_date("1/2/49"), date(2049, 2, 1))
+        self.assertEqual(parse_date("1/2/50"), date(1950, 2, 1))
+        self.assertEqual(parse_date("1/2/68"), date(1968, 2, 1))
+
+    def test_american_order_when_the_middle_number_is_above_12(self):
+        self.assertEqual(parse_date("10/23/2026"), date(2026, 10, 23))
+        self.assertEqual(parse_date("10.23.26"), date(2026, 10, 23))
+
+    def test_spaces_inside_the_parts_are_tolerated(self):
+        self.assertEqual(parse_date("5/ 6/2026"), date(2026, 6, 5))
+
+
+class RejectedTest(unittest.TestCase):
+    def test_empty_and_none(self):
+        for s in (None, "", "   "):
+            self.assertIsNone(parse_date(s))
+
+    def test_dashes_only_in_iso_order(self):
+        self.assertIsNone(parse_date("23-10-2026"))
+        self.assertIsNone(parse_date("26-10-23"))
+
+    def test_impossible_dates_give_none(self):
+        for s in ("31/02/2026", "2026-02-30", "13/13/2026", "0/1/2026"):
+            self.assertIsNone(parse_date(s), s)
+
+    def test_malformed(self):
+        for s in ("abc", "23/10", "5/6/202", "23.10/2026", "1/a/2026", "5/6/ 2026"):
+            self.assertIsNone(parse_date(s), s)
+
+
+if __name__ == "__main__":
+    unittest.main()
