diff --git a/inbox/state.py b/inbox/state.py
index 9876f67..b586993 100644
--- a/inbox/state.py
+++ b/inbox/state.py
@@ -1,10 +1,18 @@
-"""State of the notifications panel."""
+"""State of the notifications panel.
 
-INITIAL = {"items": []}
+status is "idle" before the first fetch, "loading" while a fetch is in flight, "ready" after one succeeded and "error"
+after one failed. items keeps the last list that loaded, so a failed refresh does not wipe what is on screen."""
+
+INITIAL = {"status": "idle", "items": [], "error": None}
 
 
 def reduce(state, event):
     """The state after one event. Never mutates `state`."""
-    if event["type"] == "fetch_succeeded":
-        return {**state, "items": list(event["items"])}
+    kind = event["type"]
+    if kind == "fetch_started":
+        return {**state, "status": "loading", "error": None}
+    if kind == "fetch_succeeded":
+        return {**state, "status": "ready", "items": list(event["items"]), "error": None}
+    if kind == "fetch_failed":
+        return {**state, "status": "error", "error": event["error"]}
     return state
