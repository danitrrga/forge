diff --git a/inbox/state.py b/inbox/state.py
index 9876f67..b91873f 100644
--- a/inbox/state.py
+++ b/inbox/state.py
@@ -1,10 +1,17 @@
-"""State of the notifications panel."""
+"""State of the notifications panel.
 
-INITIAL = {"items": []}
+loading: a fetch is in flight. loaded: at least one fetch has succeeded. error: why the last fetch failed, or None."""
+
+INITIAL = {"items": [], "loading": False, "loaded": False, "error": None}
 
 
 def reduce(state, event):
     """The state after one event. Never mutates `state`."""
-    if event["type"] == "fetch_succeeded":
-        return {**state, "items": list(event["items"])}
+    kind = event["type"]
+    if kind == "fetch_started":
+        return {**state, "loading": True, "error": None}
+    if kind == "fetch_succeeded":
+        return {**state, "loading": False, "loaded": True, "error": None, "items": list(event["items"])}
+    if kind == "fetch_failed":
+        return {**state, "loading": False, "error": event["error"] or "unknown error"}
     return state
