diff --git a/crm/merge.py b/crm/merge.py
index d6d08ff..bc789aa 100644
--- a/crm/merge.py
+++ b/crm/merge.py
@@ -15,11 +15,16 @@ def merge_contacts(*exports):
 
     Returns one dict per person, in order of first appearance.
     """
-    merged = {}
+    people = {}
     for export in exports:
         for record in export:
-            current = merged.setdefault(_key(record["email"]), {})
-            for field, value in record.items():
-                if value:
-                    current[field] = value
-    return list(merged.values())
+            people.setdefault(_key(record["email"]), []).append(record)
+    return [_fold(records) for records in people.values()]
+
+
+def _fold(records):
+    """One record from a person's records, oldest first: per field, the newest value that is not None."""
+    result = {}
+    for record in records:
+        result.update((field, value) for field, value in record.items() if value is not None)
+    return result
