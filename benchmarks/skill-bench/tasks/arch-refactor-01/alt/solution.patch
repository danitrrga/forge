 Rows are dicts: {"date": "2026-03-01", "customer": "Ana Ruiz", "amount_cents": 1250}.
 """
 
+HEADER = "date,customer,amount"
+
+# What differs between the three files. Payouts go to the bank, whose importer wants CRLF and needs
+# line breaks inside a name quoted; it also must not receive zero rows.
+FORMATS = {
+    "sales": {"sign": 1, "skip_zero": False, "special": ',"', "eol": "\n"},
+    "refunds": {"sign": -1, "skip_zero": False, "special": ',"', "eol": "\n"},
+    "payouts": {"sign": 1, "skip_zero": True, "special": ',"\n', "eol": "\r\n"},
+}
+
+
+def _field(text, special):
+    text = text.replace('"', '""')
+    return '"%s"' % text if any(c in text for c in special) else text
+
+
+def _export(kind, rows):
+    f = FORMATS[kind]
+    lines = [HEADER]
+    for r in rows:
+        cents = r["amount_cents"]
+        if f["skip_zero"] and cents == 0:
+            continue
+        lines.append(",".join([r["date"], _field(r["customer"], f["special"]), "%.2f" % (f["sign"] * cents / 100)]))
+    return f["eol"].join(lines) + f["eol"]
+
 
