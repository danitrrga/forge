--- a/alerts.py
+++ b/alerts.py
@@ -3,8 +3,11 @@
 An alert: {"severity": "info" | "warning" | "critical", "title": ..., "service": ..., "at": ISO time,
            "details": optional text}
 """
+from abc import ABC, abstractmethod
+
 import config
 import mailer
+import sms
 
 
 def subject(alert):
@@ -15,6 +18,36 @@ def body(alert):
     return "%s\n\nService: %s\nAt: %s\n\n%s\n" % (alert["title"], alert["service"], alert["at"], alert.get("details", ""))
 
 
+class Channel(ABC):
+    """A way of reaching on-call. Add a subclass and list it in CHANNELS to support a new one."""
+
+    def __init__(self, min_severity):
+        self.min_severity = min_severity
+
+    def wants(self, alert):
+        return SEVERITY_RANK[alert["severity"]] >= SEVERITY_RANK[self.min_severity]
+
+    @abstractmethod
+    def send(self, alert):
+        ...
+
+
+class EmailChannel(Channel):
+    def send(self, alert):
+        mailer.send_email(config.ONCALL_EMAIL, subject(alert), body(alert))
+
+
+class SmsChannel(Channel):
+    def send(self, alert):
+        sms.send_sms(config.ONCALL_PHONE, subject(alert)[:sms.MAX_LENGTH])
+
+
+SEVERITY_RANK = {"info": 0, "warning": 1, "critical": 2}
+CHANNELS = [EmailChannel("info"), SmsChannel("critical")]
+
+
 def notify(alert):
-    """Tell on-call about an alert."""
-    mailer.send_email(config.ONCALL_EMAIL, subject(alert), body(alert))
+    """Tell on-call about an alert through every channel that wants it."""
+    for channel in CHANNELS:
+        if channel.wants(alert):
+            channel.send(alert)
