diff --git c/tests/test_timeouts.py i/tests/test_timeouts.py
new file mode 100644
index 0000000..b98ba82
--- /dev/null
+++ i/tests/test_timeouts.py
@@ -0,0 +1,26 @@
+import unittest
+
+from fake_http import patch_urlopen
+from payments import capture, charge, refund, webhooks_gen
+from shipping import geo
+
+
+class TimeoutTest(unittest.TestCase):
+    def test_payments_calls_use_the_shared_timeout(self):
+        patcher, calls = patch_urlopen({})
+        with patcher:
+            charge.charge(100, "tok")
+            capture.capture("ch_1")
+            refund.refund("ch_1", 50)
+            webhooks_gen.register_webhook({"url": "https://shop.example.test/hook"})
+        self.assertEqual({c[2]["timeout"] for c in calls}, {30})
+
+    def test_geocoder_keeps_its_own_timeout(self):
+        patcher, calls = patch_urlopen([{"lat": 0, "lon": 0}])
+        with patcher:
+            geo.geocode("x")
+        self.assertEqual(calls[0][2]["timeout"], 5)
+
+
+if __name__ == "__main__":
+    unittest.main()
