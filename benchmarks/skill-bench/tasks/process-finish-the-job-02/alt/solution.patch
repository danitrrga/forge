diff --git a/money.py b/money.py
index cef75db..d03e15d 100644
--- a/money.py
+++ b/money.py
@@ -1,3 +1,4 @@
 def fmt_money(cents):
-    """Integer cents as euros for the report: 123456 -> '€1,234.56'."""
-    return "€{:,}.{:02d}".format(cents // 100, cents % 100)
+    """Integer cents as euros for the report: 123456 -> '€1,234.56', -1250 -> '€-12.50'."""
+    euros, rest = divmod(abs(cents), 100)
+    return "€{}{:,}.{:02d}".format("-" if cents < 0 else "", euros, rest)
diff --git a/report.py b/report.py
index be22323..e4803bb 100644
--- a/report.py
+++ b/report.py
@@ -27,12 +27,34 @@ def table(title, pairs):
     return "<h2>%s</h2>\n<table>%s</table>\n" % (html.escape(title), body)
 
 
+def region_table(rows):
+    """Sales, refunds and net per region, largest net first, with a total row that equals the grand total."""
+    regions = {}
+    for r in rows:
+        sales, refunds = regions.get(r["region"], (0, 0))
+        if r["kind"] == "refund":
+            refunds += r["amount_cents"]
+        else:
+            sales += r["amount_cents"]
+        regions[r["region"]] = (sales, refunds)
+    order = sorted(regions, key=lambda k: -sum(regions[k]))
+    head = "<thead><tr><th>Region</th><th>Sales</th><th>Refunds</th><th>Net</th></tr></thead>"
+    body = "".join(
+        "<tr><td>%s</td><td class=\"num\">%s</td><td class=\"num\">%s</td><td class=\"num\">%s</td></tr>"
+        % (html.escape(k), fmt_money(regions[k][0]), fmt_money(regions[k][1]), fmt_money(sum(regions[k])))
+        for k in order)
+    total = sum(sum(v) for v in regions.values())
+    foot = "<tfoot><tr><th>Total</th><td></td><td></td><td class=\"num\">%s</td></tr></tfoot>" % fmt_money(total)
+    return "<h2>By region</h2>\n<table>%s<tbody>%s</tbody>%s</table>\n" % (head, body, foot)
+
+
 def build(rows):
     grand = sum(r["amount_cents"] for r in rows)
     parts = [
         "<!doctype html>\n<meta charset=\"utf-8\">\n<title>Acme sales</title>\n<h1>Acme sales</h1>\n",
         "<p class=\"grand-total\">Grand total: %s</p>\n" % fmt_money(grand),
         table("By month", by_month(rows).items()),
+        region_table(rows),
     ]
     return "".join(parts), grand
 
