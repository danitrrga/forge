@@ -11,6 +11,18 @@ class SplitEvenlyTest(unittest.TestCase):
     def test_one_person_pays_everything(self):
         self.assertEqual(split_evenly("42.10", ["Ana"]), {"Ana": "42.10"})
 
+    def test_leftover_cents_go_to_the_first_people(self):
+        self.assertEqual(split_evenly("100.00", ["Ana", "Ben", "Cleo"]),
+                         {"Ana": "33.34", "Ben": "33.33", "Cleo": "33.33"})
+        self.assertEqual(split_evenly("1.00", ["Ana", "Ben", "Cleo", "Dan", "Eva", "Femi", "Gus"]),
+                         {"Ana": "0.15", "Ben": "0.15", "Cleo": "0.14", "Dan": "0.14", "Eva": "0.14",
+                          "Femi": "0.14", "Gus": "0.14"})
+
+    def test_amounts_that_floats_cannot_hold(self):
+        self.assertEqual(split_evenly("19.99", ["Ana", "Ben", "Cleo"]),
+                         {"Ana": "6.67", "Ben": "6.66", "Cleo": "6.66"})
+        self.assertEqual(split_evenly("0.29", ["Ana", "Ben"]), {"Ana": "0.15", "Ben": "0.14"})
+
 
 if __name__ == '__main__':
     unittest.main()
