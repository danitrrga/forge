diff --git a/shop/orders.py b/shop/orders.py
index 400e909..f3ca3d8 100644
--- a/shop/orders.py
+++ b/shop/orders.py
@@ -2,9 +2,12 @@ from shop import db
 
 
 def add_order(customer, total_cents):
-    cur = db.intake().execute(
-        "INSERT INTO orders (customer, total_cents) VALUES (?, ?)", (customer, total_cents)
-    )
+    # `with` commits: an uncommitted INSERT keeps the write lock on the long-lived intake
+    # connection, so every other connection's write fails with "database is locked".
+    with db.intake() as conn:
+        cur = conn.execute(
+            "INSERT INTO orders (customer, total_cents) VALUES (?, ?)", (customer, total_cents)
+        )
     return cur.lastrowid
 
 
