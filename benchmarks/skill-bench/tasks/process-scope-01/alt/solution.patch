diff --git c/tests/test_tracking.py i/tests/test_tracking.py
new file mode 100644
index 0000000..7c5d1b5
--- /dev/null
+++ i/tests/test_tracking.py
@@ -0,0 +1,23 @@
+import unittest
+from datetime import date
+
+from shop import events
+from shop.emails import render
+
+ORDER = events.Order(id="C-3003", customer_name="Ana Lopez", email="ana@example.test", total_cents=100)
+SHIPMENT = events.Shipment(carrier="ParcelCo", tracking_number="PC-2000-0002")
+
+
+class TrackingTest(unittest.TestCase):
+    def test_shipped_and_delivered_carry_the_tracking_number(self):
+        for event in (events.OrderShipped(ORDER, SHIPMENT),
+                      events.OrderDelivered(ORDER, SHIPMENT, date(2026, 1, 2))):
+            self.assertIn("ParcelCo: PC-2000-0002", render(event)[1])
+
+    def test_emails_before_shipping_have_no_tracking_line(self):
+        for event in (events.OrderPlaced(ORDER), events.PaymentFailed(ORDER, "card declined")):
+            self.assertNotIn("Track", render(event)[1])
+
+
+if __name__ == "__main__":
+    unittest.main()
