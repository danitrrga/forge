diff --git c/shop/emails/common.py i/shop/emails/common.py
index 596f7bb..7c7b946 100644
--- c/shop/emails/common.py
+++ i/shop/emails/common.py
@@ -8,3 +8,10 @@ def greeting(order):
 
 def footer():
     return "Questions? Just reply to this email or visit https://shop.example.test/help\n-- The Acme Shop team"
+
+
+def tracking_line(event):
+    shipment = getattr(event, "shipment", None)
+    if shipment is None:
+        return "Tracking number: we'll send it as soon as your order ships."
+    return "Tracking number: %s (%s)" % (shipment.tracking_number, shipment.carrier)
